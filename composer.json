{
  "name": "espn/cfb-ticker",
  "type": "flarum-extension",
  "description": "Flarum 2 extension that displays an ESPN FBS college football ticker in the forum header.",
  "keywords": ["flarum", "espn", "college-football", "ticker", "sports"],
  "homepage": "https://github.com/yourname/espn-cfb-ticker",
  "license": "MIT",
  "authors": [
    {
      "name": "Your Name",
      "email": "you@example.com"
    }
  ],
  "require": {
    "php": "^8.0",
    "flarum/core": "^1.0 || ^2.0"
  },
  "autoload": {
    "psr-4": {
      "Espn\\CfbTicker\\": "src/"
    }
  },
  "extra": {
    "flarum-extension": {
      "title": "ESPN CFB Ticker",
      "icon": {
        "name": "fas fa-football-ball"
      }
    }
  }
}
